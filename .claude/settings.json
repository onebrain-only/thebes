{
  "permissions": {
    "allow": [
      "Bash(git push origin alpha-*)",
      "Bash(git push -u origin alpha-*)",
      "Bash(git -C Dabbler/dabbler-code push origin alpha-*)",
      "Bash(git -C Dabbler/dabbler-design-system push origin alpha-*)",
      "Bash(git -C Dabbler/dabbler-code push origin integrate-alpha:Alpha)",
      "Bash(git -C Dabbler/dabbler-design-system push origin integrate-alpha-ds:alpha-ds)",
      "Bash(git -C Dabbler/dabbler-code push origin --delete alpha-*)",
      "Bash(git -C Dabbler/dabbler-design-system push origin --delete alpha-*)",
      "Bash(python3 -m agent.execution.*)",
      "Bash(python3 -c *agent.integrations.jira*)",
      "mcp__claude_ai_Atlassian_Rovo__transitionJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__addCommentToJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__createJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__createIssueLink",
      "Bash(python3 agent/scripts/sql_hook.py *)",
      "Edit(agent/scripts/sql_hook.py)",
      "Edit(agent/state/registry/sql_allow.json)",
      "Bash(python3 -m agent.listener conversation-dispatch *)",
      "Bash(python3 -m agent.listener submit *)",
      "Bash(python3 -m agent.execution.conversation_dispatch dispatch:*)",
      "Bash(git -C * push origin integrate-alpha:Alpha)",
      "Bash(git -C * push origin integrate-alpha-ds:alpha-ds)"
    ],
    "deny": [
      "Bash(git -C Dabbler/dabbler-code push*main*)",
      "Bash(git -C Dabbler/dabbler-code push*master*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "agent/scripts/flow-hook.sh PreToolUse",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agent/scripts/branch-guard.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agent/scripts/desktop-scope-guard.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Supabase__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agent/scripts/sql-hook.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|mcp__claude_ai_Supabase__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agent/scripts/ops-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*|Bash|Write|Edit|MultiEdit|NotebookEdit|Agent|SendMessage|CronCreate|ScheduleWakeup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agent/scripts/order-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "agent/scripts/flow-hook.sh PostToolUse",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "mcp__.*[Aa]tlassian.*__createJiraIssue|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agent/scripts/order-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent/scripts/flow-hook.sh SubagentStart",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agent/scripts/flow-hook.sh SubagentStop",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agent/scripts/policy-hook.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agent/scripts/ceo-prompt-hook.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/agent/scripts/ceo-prompt-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "dart-flutter@dart-flutter": true
  }
}
